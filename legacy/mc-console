#!/usr/bin/env bash
#
# mc-console — Minecraft サーバーの tmux コンソールにアタッチする。
# サーバーが起動していなければ systemctl で起動してからアタッチする。
# サーバーコマンド (例: whitelist add <名前>, op <名前>) を直接入力できる。
#
# デタッチ: Ctrl-b → d   (サーバーを止めたいときはアタッチせず systemctl stop minecraft)
#
# 使い方: sudo mc-console

set -euo pipefail

MC_USER="${MC_USER:-minecraft}"
TMUX_SOCKET="minecraft"
TMUX_SESSION="minecraft"
SERVICE_NAME="minecraft"

has_session() { sudo -u "$MC_USER" tmux -L "$TMUX_SOCKET" has-session -t "$TMUX_SESSION" 2>/dev/null; }

if ! has_session; then
  if [ "$(id -u)" -ne 0 ]; then
    echo "サーバーが起動していません。起動には root が必要です: sudo mc-console" >&2
    exit 1
  fi
  echo "サーバーが起動していません。systemctl start ${SERVICE_NAME} で起動します..."
  systemctl start "$SERVICE_NAME"
  for _ in $(seq 1 15); do
    if has_session; then break; fi
    sleep 1
  done
  if ! has_session; then
    echo "コンソールセッションを確認できませんでした。状態を確認してください:" >&2
    echo "  systemctl status ${SERVICE_NAME}" >&2
    exit 1
  fi
fi

echo "コンソールにアタッチします。デタッチ: Ctrl-b → d"
exec sudo -u "$MC_USER" tmux -L "$TMUX_SOCKET" attach -t "$TMUX_SESSION"
