#!/usr/bin/env bash
#
# mc-whitelist (v2 / Crafty 版) — Crafty が管理するサーバーに whitelist を追加して即反映する。
# Java は Mojang UUID、Bedrock は XUID から Floodgate UUID を計算して
# Crafty サーバーディレクトリの whitelist.json に書き、稼働中なら Crafty console API に
# `whitelist reload` を送る。
#
# Crafty の whitelist UI は Bedrock のゲーマータグ (Floodgate UUID) を扱えないため、
# このヘルパが Crafty に欠けている「クロスプレイ whitelist」を埋める。
#
# v1 (tmux 版) との違いは「書込先 / reload 経路 / 稼働判定」だけ。
#   書込先   : /opt/minecraft → $MC_DIR (Crafty サーバーディレクトリ、所有者 crafty)
#   reload   : tmux send-keys → Crafty console API (POST /servers/<uuid>/stdin)
#   稼働判定 : tmux has-session → Crafty status API (.data.running)
#
# 使い方:
#   sudo mc-whitelist <JavaName>       Java 版プレイヤーを追加
#   sudo mc-whitelist -b <Gamertag>    Bedrock 版プレイヤー (Floodgate) を追加
#
# 反映は whitelist のみ。op はサーバー再起動が必要なため、必要なら Crafty UI で付与してください。
# 設定は /etc/default/crafty-mc を参照。

set -euo pipefail

CRAFTY_MC_ENV="/etc/default/crafty-mc"
[ -r "$CRAFTY_MC_ENV" ] || { echo "✗ $CRAFTY_MC_ENV がありません。先に crafty-setup.sh を実行してください。" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CRAFTY_MC_ENV"
CRAFTY_URL="${CRAFTY_URL:-https://127.0.0.1:8443}"
CRAFTY_USER="${CRAFTY_USER:-crafty}"

[ "$(id -u)" -eq 0 ] || { echo "root で実行してください: sudo mc-whitelist ..." >&2; exit 1; }
case "${CRAFTY_TOKEN:-}" in ''|TODO*) echo "✗ $CRAFTY_MC_ENV の CRAFTY_TOKEN が未記入です。" >&2; exit 1;; esac
case "${SERVER_UUID:-}" in ''|TODO*) echo "✗ $CRAFTY_MC_ENV の SERVER_UUID が未記入です。" >&2; exit 1;; esac
case "${MC_DIR:-}" in ''|TODO*) echo "✗ $CRAFTY_MC_ENV の MC_DIR が未記入です。" >&2; exit 1;; esac

# Crafty console API にコマンドを送る (生ボディがコマンド)。
crafty_console() {  # crafty_console <command-line>
  curl -fsSL -k -X POST -H "Authorization: Bearer ${CRAFTY_TOKEN}" \
    --data-binary "$1" "${CRAFTY_URL}/api/v2/servers/${SERVER_UUID}/stdin" >/dev/null
}
server_running() {
  curl -fsSL -k -H "Authorization: Bearer ${CRAFTY_TOKEN}" \
    "${CRAFTY_URL}/api/v2/servers/${SERVER_UUID}/stats" 2>/dev/null \
    | jq -e '.data.running == true' >/dev/null 2>&1
}

BEDROCK=0
if [ "${1:-}" = "-b" ]; then BEDROCK=1; shift; fi
NAME="${1:-}"
[ -n "$NAME" ] || { echo "使い方: sudo mc-whitelist [-b] <名前>" >&2; exit 1; }

if [ "$BEDROCK" -eq 1 ]; then
  XUID="$(curl -fsSL "https://api.geysermc.org/v2/xbox/xuid/${NAME}" 2>/dev/null | jq -r '.xuid // empty')" || XUID=""
  [ -n "$XUID" ] || { echo "Bedrock ゲーマータグの XUID を解決できません: $NAME" >&2; exit 1; }
  HEX="$(printf '%016x' "$XUID")"
  UUID="00000000-0000-0000-${HEX:0:4}-${HEX:4:12}"
  ENTRY_NAME=".${NAME}"
else
  ID="$(curl -fsSL "https://api.mojang.com/users/profiles/minecraft/${NAME}" 2>/dev/null | jq -r '.id // empty')" || ID=""
  [ "${#ID}" -eq 32 ] || { echo "Java 名の Mojang UUID を解決できません: $NAME" >&2; exit 1; }
  UUID="${ID:0:8}-${ID:8:4}-${ID:12:4}-${ID:16:4}-${ID:20:12}"
  ENTRY_NAME="$NAME"
fi

WL="$MC_DIR/whitelist.json"
tmp="$(mktemp)"
if [ -f "$WL" ] && jq -e . "$WL" >/dev/null 2>&1; then
  jq --arg u "$UUID" --arg n "$ENTRY_NAME" 'map(select(.uuid != $u)) + [{uuid:$u,name:$n}]' "$WL" > "$tmp"
else
  jq -n --arg u "$UUID" --arg n "$ENTRY_NAME" '[{uuid:$u,name:$n}]' > "$tmp"
fi
mv "$tmp" "$WL"
chown "$CRAFTY_USER":"$CRAFTY_USER" "$WL"
echo "whitelist.json に追加: ${ENTRY_NAME}  (${UUID})"

if server_running; then
  crafty_console 'whitelist reload'
  echo "起動中のサーバーに 'whitelist reload' を送信しました(即反映)。"
else
  echo "サーバーは未起動です。次回起動時に反映されます。"
fi
