#!/usr/bin/env bash
#
# mc-maintain — Crafty 移行後に「Crafty が面倒を見ない」維持作業だけを行う。
#   1. Java 昇格 : MC バージョンが要求する Eclipse Temurin をホストに導入し、
#                  Crafty の「Java Path」に貼る絶対パスを確定 (Crafty はホスト Java を入れない)。
#   2. プラグイン更新 : Geyser / Floodgate を geysermc.org の latest に差し替え
#                  (Crafty は Paper 本体しか更新しない)。
#
# 旧 update.sh から「Paper 本体の更新」と「systemctl stop/start」は除いてある
# (どちらも Crafty の仕事)。world と設定ファイルには触れない (jar の差し替えのみ)。
#
# 使い方:
#   sudo mc-maintain                Java 確認/昇格 + Geyser/Floodgate 更新
#   sudo mc-maintain --restart      上記後、稼働中なら Crafty にサーバー再起動を指示
#   MC_VERSION=1.21.12 sudo -E mc-maintain   一時的に別バージョンの Java を解決
#
# 設定は /etc/default/crafty-mc を参照。

set -euo pipefail

CRAFTY_MC_ENV="/etc/default/crafty-mc"
PAPER_UA="minecraft-oci (+https://github.com/NadjaSenpai/minecraft-oci)"

STEP=0
TOTAL_STEPS=2
SCRIPT_START="$(date +%s)"
_elapsed() { printf '%ds' "$(( $(date +%s) - SCRIPT_START ))"; }
step() { STEP=$((STEP+1)); printf '\n\033[1;36m━━━ [%d/%d] %s\033[0m\n' "$STEP" "$TOTAL_STEPS" "$*"; }
log()  { printf '  \033[1;32m•\033[0m %s\n' "$*"; }
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m! %s\033[0m\n' "$*" >&2; }
die()  { printf '\n\033[1;31m✗ ERROR: %s\033[0m\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "root で実行してください (sudo mc-maintain)"
[ -r "$CRAFTY_MC_ENV" ] || die "$CRAFTY_MC_ENV がありません。先に crafty-setup.sh を実行してください。"
# 環境変数で渡された MC_VERSION を優先 (env ファイルの sourcing で上書きされないよう退避)
MC_VERSION_OVERRIDE="${MC_VERSION:-}"
# shellcheck disable=SC1090
. "$CRAFTY_MC_ENV"
MC_VERSION="${MC_VERSION_OVERRIDE:-${MC_VERSION:-}}"
CRAFTY_URL="${CRAFTY_URL:-https://127.0.0.1:8443}"
CRAFTY_USER="${CRAFTY_USER:-crafty}"

[ -n "$MC_VERSION" ] || die "MC_VERSION が未設定です ($CRAFTY_MC_ENV)。"
case "${MC_DIR:-}" in ''|TODO*) die "$CRAFTY_MC_ENV の MC_DIR が未記入です (例: /var/opt/minecraft/server/<uuid>)。";; esac
[ -d "$MC_DIR" ] || die "MC_DIR が存在しません: $MC_DIR"

RESTART_FLAG=0
[ "${1:-}" = "--restart" ] && RESTART_FLAG=1

# PaperMC fill API の JSON を取得する (CDN の gzip 不整合に対応)。
paper_meta() {  # paper_meta <url> -> JSON を stdout へ
  local tmp; tmp="$(mktemp)"
  if ! curl -fsSL -A "$PAPER_UA" "$1" -o "$tmp"; then rm -f "$tmp"; return 1; fi
  if gzip -t "$tmp" 2>/dev/null; then gzip -dc "$tmp"; else cat "$tmp"; fi
  rm -f "$tmp"
}

# crafty 所有のまま latest を取得する (root でダウンロード → mv → chown)。
fetch_plugin() {  # fetch_plugin <url> <dest> <label>
  local url=$1 dest=$2 label=$3 tmp
  tmp="$(mktemp)"
  log "ダウンロード: $label"
  if ! curl -fL --progress-bar "$url" -o "$tmp"; then rm -f "$tmp"; die "$label の取得に失敗しました。"; fi
  mv "$tmp" "$dest"
  chown "$CRAFTY_USER":"$CRAFTY_USER" "$dest"
}

# ---------------------------------------------------------------------------
# 1. Java 昇格 (MC が要求する Temurin をホストに導入)
# ---------------------------------------------------------------------------
step "Java の確認 / 昇格"
JAVA_MIN="$(paper_meta "https://fill.papermc.io/v3/projects/paper/versions/${MC_VERSION}" 2>/dev/null | jq -r '.version.java.version.minimum // empty')" || JAVA_MIN=""
[ -n "$JAVA_MIN" ] || JAVA_MIN=21
JAVA_BIN="$(ls -d /usr/lib/jvm/temurin-"${JAVA_MIN}"-jdk-*/bin/java 2>/dev/null | head -1 || true)"
if [ -z "$JAVA_BIN" ] || [ ! -x "$JAVA_BIN" ]; then
  log "Minecraft $MC_VERSION は Java ${JAVA_MIN} が必要。temurin-${JAVA_MIN}-jdk を導入します..."
  export DEBIAN_FRONTEND=noninteractive
  if [ ! -f /etc/apt/sources.list.d/adoptium.list ]; then
    install -d -m 0755 /etc/apt/keyrings
    curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg
    chmod a+r /etc/apt/keyrings/adoptium.gpg
    CODENAME="$(. /etc/os-release && echo "${VERSION_CODENAME:-jammy}")"
    echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb ${CODENAME} main" \
      > /etc/apt/sources.list.d/adoptium.list
  fi
  apt-get update -qq
  apt-get install -y "temurin-${JAVA_MIN}-jdk"
  JAVA_BIN="$(ls -d /usr/lib/jvm/temurin-"${JAVA_MIN}"-jdk-*/bin/java 2>/dev/null | head -1 || true)"
fi
{ [ -n "$JAVA_BIN" ] && [ -x "$JAVA_BIN" ]; } || die "Temurin ${JAVA_MIN} が見つかりません。"
ok "Java ${JAVA_MIN}: $JAVA_BIN"

# crafty-mc env の JAVA_BIN を追従 (参照用)。
if grep -q '^JAVA_BIN=' "$CRAFTY_MC_ENV"; then
  sed -i "s|^JAVA_BIN=.*|JAVA_BIN=${JAVA_BIN}|" "$CRAFTY_MC_ENV"
else
  echo "JAVA_BIN=${JAVA_BIN}" >> "$CRAFTY_MC_ENV"
fi
warn "Java を昇格した場合、Crafty UI のサーバー Config → 'Java Path' を次の値に更新してください:"
warn "  $JAVA_BIN"

# ---------------------------------------------------------------------------
# 2. プラグイン (Geyser / Floodgate) の更新
# ---------------------------------------------------------------------------
step "プラグイン (Geyser / Floodgate) の更新"
install -d -o "$CRAFTY_USER" -g "$CRAFTY_USER" -m 0755 "$MC_DIR/plugins"
fetch_plugin "https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/spigot" \
  "$MC_DIR/plugins/Geyser-Spigot.jar" "GeyserMC (Spigot, latest)"
ok "Geyser-Spigot.jar を更新"
fetch_plugin "https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/spigot" \
  "$MC_DIR/plugins/floodgate-spigot.jar" "Floodgate (Spigot, latest)"
ok "floodgate-spigot.jar を更新"

# 反映には再起動が必要。
if [ "$RESTART_FLAG" -eq 1 ]; then
  case "${CRAFTY_TOKEN:-}" in
    ''|TODO*) warn "CRAFTY_TOKEN 未記入のため再起動できません。Crafty UI で再起動してください。" ;;
    *)
      log "Crafty にサーバー再起動を指示します..."
      curl -fsSL -k -X POST -H "Authorization: Bearer ${CRAFTY_TOKEN}" \
        "${CRAFTY_URL}/api/v2/servers/${SERVER_UUID}/action/restart_server" >/dev/null \
        && ok "再起動を指示しました。" || warn "再起動指示に失敗。Crafty UI を確認してください。" ;;
  esac
else
  warn "プラグインを差し替えました。反映には再起動が必要です (Crafty UI、または --restart)。"
fi

printf '\n\033[1;32m✓ 維持作業 完了\033[0m  (所要時間 %s)\n  Java %s / Geyser・Floodgate latest\n\n' \
  "$(_elapsed)" "$JAVA_MIN"
